#include "stm32f446xx_gpio_driver.h"
#include <string.h>

void UART_Init(void) {
    // Enable clock for GPIOA
    RCC->AHB1ENR |= (1 << 0);
    // Enable clock for USART2
    RCC->APB1ENR |= (1 << 17);

    // Set PA2 to alternate function mode (TX)
    GPIOA->MODER &= ~(3 << (2 * 2));
    GPIOA->MODER |= (2 << (2 * 2));
    // Set alternate function to AF7 (USART2)
    GPIOA->AFR[0] |= (7 << (2 * 4));

    // Configure USART2: 9600 baud rate (assuming 16MHz clock)
    USART2->BRR = 0x683;
    // Enable transmitter and USART
    USART2->CR1 |= (1 << 3) | (1 << 13);
}

void UART_SendChar(char c) {
    // Wait until transmit data register is empty
    while (!(USART2->SR & (1 << 7)));
    USART2->DR = c;
}

void UART_SendString(const char* str) {
    while (*str) {
        UART_SendChar(*str++);
    }
}

int main(void) {
    UART_Init();

    while (1) {
        UART_SendString("Button pressed!\r\n");
        // Add a delay here if needed
    }
}
